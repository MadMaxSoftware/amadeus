{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["continue", "complete", "needs_approval", "blocked"], "description": "Choose exactly one control state. Use continue when another bounded in-scope step remains; use blocked only when this invocation must stop." },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "nextObjective": { "type": ["string", "null"] },
    "nextStreamObjective": { "type": ["string", "null"] },
    "remainingCriterion": { "type": ["string", "null"] },
    "question": { "type": ["string", "null"] },
    "recovery": {
      "description": "MUST be null for continue, complete, and needs_approval. A non-null recovery is permitted only with status=blocked for a technical same-scope repair.",
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false,
          "properties": { "diagnosis": { "type": "string" }, "nextObjective": { "type": "string" }, "scope": { "type": "string", "enum": ["same-approved-scope"] } },
          "required": ["diagnosis", "nextObjective", "scope"] }
      ]
    },
    "hostHandoff": {
      "description": "If the next step requires the host, including running tests or commands outside the sandbox or anything the sandbox blocks, return status=blocked with hostHandoff.action naming the already-authorized host action; do not return continue with nextObjective asking another worker to do it. Otherwise MUST be null. Never set together with recovery.",
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false,
          "properties": { "action": { "type": "string" } },
          "required": ["action"] }
      ]
    },
    "nextRoute": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false,
          "properties": { "provider": { "type": "string", "enum": ["codex-chatgpt-signin", "cursor-browser-login"] }, "model": { "type": "string" }, "reasoningEffort": { "type": ["string", "null"] } },
          "required": ["provider", "model", "reasoningEffort"] }
      ]
    }
  },
  "required": ["status", "summary", "evidence", "nextObjective", "nextStreamObjective", "remainingCriterion", "question", "recovery", "hostHandoff", "nextRoute"]
}
